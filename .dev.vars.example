# Copy to .dev.vars for local `npm run dev` (wrangler reads it automatically).
# .dev.vars is git-ignored. Never commit real values.

TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-BotFather
# Generate with: npm run secret:generate
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
# Local dev requests don't come from Telegram IPs
ENFORCE_TELEGRAM_IP=false
