# Used only by `npm run setup:webhook` (runs on your machine, not on Cloudflare).
# Copy to .env (git-ignored) or export these in your shell.

TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-BotFather
TELEGRAM_WEBHOOK_SECRET=same-value-you-put-in-wrangler-secret
# Your deployed Worker URL + /telegram/webhook
WEBHOOK_URL=https://study-jio-bot.<your-subdomain>.workers.dev/telegram/webhook
